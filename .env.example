# Copie para .env (na raiz do projeto) e ajuste. O .env nunca vai para o Git.

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Docker Compose (npm run db:up) e o PostgreSQL embutido (npm run db:embedded)
# usam a porta 5433 para não conflitar com um PostgreSQL nativo na 5432.
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=biblioteca_jogos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://biblioteca:troque-esta-senha@localhost:5433/biblioteca_jogos?schema=public
# Banco usado só pelos testes da API (é truncado a cada teste). Se omitido,
# usa o DATABASE_URL com o sufixo _test no nome do banco.
TEST_DATABASE_URL=postgresql://biblioteca:troque-esta-senha@localhost:5433/biblioteca_jogos_test?schema=public

# --- API ----------------------------------------------------------------------
PORT=3333
# Endereço em que a API escuta. Vazio = 127.0.0.1 (só este computador) em
# desenvolvimento e 0.0.0.0 em produção. Use 0.0.0.0 só se quiser abrir na rede.
# HOST=127.0.0.1
# Obrigatório trocar (o servidor recusa o texto de exemplo). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SESSION_TTL_HOURS=168
# Origem do frontend (várias separadas por vírgula)
CLIENT_ORIGIN=http://localhost:5173
# Obsoleta desde a 3.0: não abre mais a biblioteca. Para compartilhar, use o perfil
# público em Configurações → Privacidade (/u/<usuário>), que respeita cada preferência.
PUBLIC_READ=false
# Endereço público do app quando hospedado (ex.: https://biblioteca.exemplo.com).
# Vazio = só local: a interface não oferece "copiar link" do perfil.
# PUBLIC_APP_URL=
# Requisições por minuto, por IP, nas rotas públicas (/api/public)
PUBLIC_RATE_LIMIT=120
# Fuso de "hoje", semana e mês do diário e das metas
APP_TIMEZONE=America/Sao_Paulo
# auto = Secure apenas em produção
COOKIE_SECURE=auto
# true quando estiver atrás de proxy reverso (Render, Railway, Nginx...)
TRUST_PROXY=false
LOGIN_RATE_LIMIT=10
# Cadastro público de novas contas (true no site publicado; false = só npm run admin:create)
ALLOW_SIGNUP=false
# Cadastros por hora, por IP
SIGNUP_RATE_LIMIT=5

# --- Uploads ------------------------------------------------------------------
# Pasta local (desenvolvimento). Em produção use um volume persistente.
# UPLOAD_DIR=./server/uploads
MAX_UPLOAD_MB=5
# Onde guardar as imagens: local (pasta UPLOAD_DIR) ou r2 (Cloudflare R2, para hosts sem
# disco persistente, como o Render grátis). Com r2, as quatro variáveis R2_* são obrigatórias.
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
MAX_IMAGES_PER_GAME=20
LEGACY_IMPORT_MAX_MB=30

# --- Steam (opcional) ---------------------------------------------------------
# Chave da Web API da Steam para importar a biblioteca (Configurações → Conta Steam).
# Gere em https://steamcommunity.com/dev/apikey (32 caracteres). Sem ela, a importação
# aparece desativada. A chave fica só no servidor: nunca vai para a página nem para logs.
# STEAM_API_KEY=
# Dias de validade do cache de dados da loja (compartilhado entre usuários)
STEAM_CACHE_DAYS=30
# Intervalo mínimo entre chamadas (ms). A loja (appdetails) tem limite de uso baixo.
STEAM_STORE_INTERVAL_MS=1500
STEAM_API_INTERVAL_MS=250
STEAM_TIMEOUT_MS=10000
# Requisições por minuto, por usuário, nas rotas que consultam a Steam
STEAM_RATE_LIMIT=30

# --- Proprietário (usado por: npm run admin:create) ---------------------------
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-forte
