# Copie para .env (na raiz do projeto) e ajuste. O .env nunca vai para o Git.

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Docker Compose (npm run db:up) e o PostgreSQL embutido (npm run db:embedded)
# usam a porta 5433 para não conflitar com um PostgreSQL nativo na 5432.
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=biblioteca_jogos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://biblioteca:troque-esta-senha@localhost:5433/biblioteca_jogos?schema=public
# Banco usado só pelos testes da API (é truncado a cada teste). Se omitido,
# usa o DATABASE_URL com o sufixo _test no nome do banco.
TEST_DATABASE_URL=postgresql://biblioteca:troque-esta-senha@localhost:5433/biblioteca_jogos_test?schema=public

# --- API ----------------------------------------------------------------------
PORT=3333
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SESSION_TTL_HOURS=168
# Origem do frontend (várias separadas por vírgula)
CLIENT_ORIGIN=http://localhost:5173
# true = visitantes podem VER a coleção (somente leitura). false = tudo exige login.
PUBLIC_READ=false
# auto = Secure apenas em produção
COOKIE_SECURE=auto
# true quando estiver atrás de proxy reverso (Render, Railway, Nginx...)
TRUST_PROXY=false
LOGIN_RATE_LIMIT=10

# --- Uploads ------------------------------------------------------------------
# Pasta local (desenvolvimento). Em produção use um volume persistente.
# UPLOAD_DIR=./server/uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_GAME=20
LEGACY_IMPORT_MAX_MB=30

# --- Proprietário (usado por: npm run admin:create) ---------------------------
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-forte
