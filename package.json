{
  "name": "biblioteca-jogos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Biblioteca pessoal de jogos — React + Vite + Tailwind no frontend, Express + Prisma + PostgreSQL na API",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "npm run dev -w server",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run",
    "test:server": "npm run test -w server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:embedded": "npm run db:embedded -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:dev": "npm run db:migrate:dev -w server",
    "db:studio": "npm run db:studio -w server",
    "admin:create": "npm run admin:create -w server --",
    "import:legacy": "npm run import:legacy -w server --",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "react-router": "^7.9.0",
    "recharts": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
