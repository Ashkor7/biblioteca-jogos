{
  "name": "@biblioteca-jogos/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST da Biblioteca de Jogos (Express + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "admin:create": "node scripts/create-admin.js",
    "import:legacy": "node scripts/import-legacy.js",
    "postinstall": "prisma generate",
    "db:embedded": "node scripts/embedded-db.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
